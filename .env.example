# PostgreSQL Database Configuration
# Copy this file to .env and update with your credentials

DB_NAME=german_vocabulary
DB_USER=local_db_user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Auth — the value below works for local use; generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3f2a1b8c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a

# LLM — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Set to true to skip the LLM and return random mock replies (useful during development)
MOCK_LLM=false

# CORS — comma-separated allowed origins. Defaults to the localhost dev origin
# when unset or empty. Example for production web only:
#   CORS_ORIGINS=https://app.example.com,https://staging.example.com
# For a Capacitor / iOS native build the deployed backend must ALSO allow the
# WKWebView origins:
#   CORS_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost
# See docs/CAPACITOR_READINESS.md §9 for the full config + verification steps.
CORS_ORIGINS=http://localhost:5173

# Security headers (S5). HSTS is OFF by default so local HTTP dev isn't pinned
# to HTTPS. Set to true ONLY when the app is served over TLS in production.
ENABLE_HSTS=false

# Auth throttling (S1). When the app runs behind a reverse proxy / load
# balancer that sets X-Forwarded-For, set this true so the per-IP login and
# register limits key on the real client IP instead of the proxy's. Leave
# false otherwise — a client can spoof X-Forwarded-For to dodge the throttle.
TRUST_PROXY_HEADERS=false
