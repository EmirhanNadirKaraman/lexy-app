# PostgreSQL Database Configuration
# Copy this file to .env and update with your credentials

DB_NAME=german_vocabulary
DB_USER=local_db_user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Database TLS (S4). Controls TLS for ALL DB connections — the app's asyncpg
# pool, Alembic migrations, and the subtitle-scraper psycopg2 scripts.
#   disable      → plaintext (default; fine for a localhost / private-network DB)
#   require      → encrypt the connection, but don't validate the server cert
#   verify-ca    → encrypt + verify the cert chains to a trusted CA
#   verify-full  → encrypt + verify CA + verify the hostname matches the cert
# Use `require` for remote managed Postgres unless the platform terminates DB
# traffic on a private network; prefer `verify-full` over the public internet.
# (`prefer`/`allow` are intentionally NOT accepted — they silently fall back to
# plaintext.) An unrecognised value fails fast at startup.
DB_SSL_MODE=disable

# Auth — the value below works for local use; generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3f2a1b8c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a

# LLM — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Set to true to skip the LLM and return random mock replies (useful during development)
MOCK_LLM=false

# --- LLM provider selection -------------------------------------------------
# Leave everything below UNSET for the shipped behaviour: Anthropic with the
# default model. These only matter if you point the backend at a self-hosted
# model server.
#
#   LLM_PROVIDER=anthropic          (default when unset)
#   LLM_PROVIDER=openai_compatible  any server speaking /chat/completions —
#                                   Ollama's /v1, llama.cpp's llama-server,
#                                   vLLM, LM Studio, TGI
# LLM_PROVIDER=anthropic

# Overrides the model for whichever provider is selected. Optional for
# anthropic (falls back to claude-haiku-4-5-20251001), REQUIRED for
# openai_compatible. Note: the model name is part of every llm_cache key, so
# changing it re-namespaces the cache — correct, but a cold start.
# LLM_MODEL=gemma3:12b

# Base URL for openai_compatible, including the version path. Required for
# that provider; unused by anthropic. Any reachable host — the model server is
# NOT assumed to be local. Over Tailscale, use the machine name or its 100.x
# address:
#   LLM_BASE_URL=http://desktop-tailscale-name:11434/v1
#   LLM_BASE_URL=http://100.101.102.103:11434/v1
#   LLM_BASE_URL=http://desktop-name:8080/v1
#
# SECURITY: a self-hosted model server has no meaningful authentication. Keep
# it on Tailscale or another authenticated tunnel — do not expose it to the
# public internet or bind it to 0.0.0.0 on an untrusted network.
# LLM_BASE_URL=

# Optional. Most local servers ignore auth entirely; when unset a placeholder
# is sent so the Authorization header stays well-formed.
# LLM_API_KEY=

# Optional, seconds. Defaults to 60. A local server has no built-in timeout of
# its own, and a large model on a cold cache can take a while on first token.
# LLM_TIMEOUT_SECONDS=60

# CORS — comma-separated allowed origins. Defaults to the localhost dev origin
# when unset or empty. Example for production web only:
#   CORS_ORIGINS=https://app.example.com,https://staging.example.com
# For a Capacitor / iOS native build the deployed backend must ALSO allow the
# WKWebView origins:
#   CORS_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost
# See docs/CAPACITOR_READINESS.md §9 for the full config + verification steps.
CORS_ORIGINS=http://localhost:5173

# Security headers (S5). HSTS is OFF by default so local HTTP dev isn't pinned
# to HTTPS. Set to true ONLY when the app is served over TLS in production.
ENABLE_HSTS=false

# Interactive API docs (S11). Exposes /docs, /redoc, and /openapi.json (the
# latter enumerates every route + model). OFF by default — leave false in
# production. Set true only for local development.
ENABLE_DOCS=false

# Auth throttling (S1). When the app runs behind a reverse proxy / load
# balancer that sets X-Forwarded-For, set this true so the per-IP login and
# register limits key on the real client IP instead of the proxy's. Leave
# false otherwise — a client can spoof X-Forwarded-For to dodge the throttle.
TRUST_PROXY_HEADERS=false

# Invite/registration code (S2). Leave EMPTY for open registration (still
# protected by the S1 per-IP register throttle). Set to a secret value to make
# signup invite-only: /auth/register then requires a matching `registration_code`
# in the body, and any mismatch fails with the same generic error as a duplicate
# email (so it doesn't reveal the cause). Full open-signup abuse mitigation still
# wants email verification / CAPTCHA — see docs/SECURITY.md.
REGISTRATION_CODE=

# ── Deploy posture: SINGLE WORKER ONLY (P2 decision, 2026-07-27) ─────────────
# There is no env var here — this is a constraint on how you START the app.
#
# Run exactly ONE backend process. Do NOT add `--workers N` to uvicorn, do not
# put gunicorn in front of it, and do not run multiple pods/dynos/containers.
#
# Why: `services/rate_limiter.py` keeps its sliding windows in process memory.
# That store backs the S1 login brute-force + password-spray guards, the S6
# client-error DoS guard, and the #39 flood guard — not just the LLM budget.
# With N workers each keeping its own counters, every one of those limits
# effectively becomes N times looser: LOGIN_MAX_ATTEMPTS=10 becomes 10N per
# account. That is a security regression, not a cost issue.
#
# Separately, entrypoint.sh runs `alembic upgrade head` before starting the
# server, so multiple CONTAINERS also race on migrations — a distinct failure
# from multiple workers in one container, and it bites first.
#
# Safe to scale horizontally only after a shared (Redis) rate-limit backend
# ships. See docs/SECURITY_ARCHITECTURE_DECISIONS.md §3 for the plan.
